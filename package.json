{
  "name": "commerce-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @commerce/db generate",
    "db:migrate": "pnpm --filter @commerce/db migrate",
    "db:seed": "pnpm --filter @commerce/db seed"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3"
  }
}
